@page
@model SkillBridge.Web.Pages.Admin.Quizzes.IndexModel
@{
    ViewData["Title"] = "Quizzes";
}
<a asp-page="/JianYi/Admin/Index" class="breadcrumbs">← Administration</a>
<div class="page-head">
    <div>
        <p class="eyebrow">COURSE ASSESSMENTS</p>
        <h1>Quizzes</h1>
        <p>View course assessments and their publication status.</p>
    </div>
</div>
<!--FOR CREATE QUIZ will go to dedicated page -->
<a class="btn primary" asp-page="/Timothy/Admin/Quizzes/Create">Create quiz</a>
@if (!string.IsNullOrEmpty(Model.StatusMessage)) { <p role="status">@Model.StatusMessage</p> }
<form method="get" class="card card-body section-space">
    <div asp-validation-summary="All" class="field-error" role="alert"></div>
    <div class="grid two">
        <div class="field"><label asp-for="Search">Search quiz or course</label><input asp-for="Search" class="control" maxlength="120" /></div>
        <div class="field"><label asp-for="Status">Publication status</label><select asp-for="Status" class="control"><option value="">All statuses</option><option>Draft</option><option>Published</option></select></div>
    </div>
    <div class="actions"><button class="btn primary" type="submit">Filter</button><a asp-page="Index" class="btn secondary">Clear filters</a></div>
</form>
<p role="status">@Model.Quizzes.Count quizzes found.</p>
@if (Model.Quizzes.Count == 0)
{
    <section class="card empty">
        <h2>No matching quizzes</h2>
        <p>Clear the filters or create a quiz.</p>
    </section>
}
else
{
    <div class="card table-wrap">
        <table class="data-table quiz-management-table">
            <thead>
                <tr>
                    <th scope="col">Quiz</th>
                    <th scope="col">Course</th>
                    <th scope="col">Questions</th>
                    <th scope="col">Pass Mark</th>
                    <th scope="col">Attempts</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var quiz in Model.Quizzes )
                {
                    //how to make the attempts however?
                    <tr>
                        <td><span class="table-label">Quiz</span>@quiz.Title</td>
                        <td><span class="table-label">Course</span>@quiz.CourseTitle</td>
                        <td><span class="table-label">Questions</span>@quiz.QuestionCount</td>
                       <td><span class="table-label">Pass Mark </span>@quiz.PassPercentage</td>
                       <td><span class="table-label">Attempts</span>@quiz.attempts</td>
                        <td>
                            <span class="table-label">Status</span>
                            <span class="badge @(quiz.IsPublished ? "success" : "warning")">@(quiz.IsPublished ? "Published" : "Draft")</span>
                        </td>
                        <td class="actions">
                            <a asp-page="/Timothy/Admin/Questions/Index" asp-route-quizId="@quiz.Id">Questions</a>
                            <a asp-page="/Timothy/Quizzes/Start" asp-route-quizId="@quiz.Id" aria-label="Preview @quiz.Title">Preview</a>
                            <a class="edit-btn" asp-page="/Timothy/Admin/Quizzes/Update" asp-route-id="@quiz.Id">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-quizId="@quiz.Id" data-confirm="Delete this unused quiz?">
                                <button type="submit" class="btn danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }

            </tbody>
        </table>

    </div>

}

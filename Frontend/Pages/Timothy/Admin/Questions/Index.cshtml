@page
@model SkillBridge.Web.Pages.Admin.Questions.IndexModel
@{ ViewData["Title"]="Quiz questions"; }
<a asp-page="/Timothy/Admin/Quizzes/Index" class="breadcrumbs">Back to quizzes</a>
<div class="page-head"><div><h1>@Model.Quiz.Title</h1><p>Manage question order, marks and answer options.</p></div></div>
@if(Model.StatusMessage is not null) { <p role="status">@Model.StatusMessage</p> }
@if(Model.Quiz.HasAttempts || Model.Quiz.Published)
{ <p class="alert warning">Questions are read-only while published or after the first attempt. Set an unused quiz to Draft before editing.</p> }
else { <a asp-page="Edit" asp-route-quizId="@Model.Quiz.Id" class="btn primary">Add question</a> }
<div class="card table-wrap section-space"><table class="data-table"><thead><tr><th>Order</th><th>Question</th><th>Marks</th><th>Actions</th></tr></thead><tbody>
@foreach(var question in Model.Questions)
{
<tr><td>@question.SequenceNumber</td><td>@question.Text</td><td>@question.Marks</td><td class="actions">
<a asp-page="Edit" asp-route-quizId="@Model.Quiz.Id" asp-route-id="@question.Id">View / edit</a>
@if(!Model.Quiz.HasAttempts && !Model.Quiz.Published) { <form method="post" asp-page-handler="Delete" asp-route-quizId="@Model.Quiz.Id" asp-route-id="@question.Id" data-confirm="Delete this question and its options?"><button class="btn danger" type="submit">Delete</button></form> }
</td></tr>
}
@if(Model.Questions.Count==0) { <tr><td colspan="4">No questions yet. Add a question to begin.</td></tr> }
</tbody></table></div>
<a asp-page="/Timothy/Admin/Quizzes/Update" asp-route-id="@Model.Quiz.Id" class="btn secondary">Quiz settings / publication</a>

@page "{id:long?}"
@model SkillBridge.Backend.Pages.Darren.Admin.Resources.EditModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit resource" : "Upload resource"; }
<a asp-page="Index" class="breadcrumbs">Back to resources</a>
<div class="page-head"><div><p class="eyebrow">LESSON MATERIALS</p><h1>@ViewData["Title"]</h1><p>Attach one accessible file to a lesson.</p></div></div>
<form method="post" enctype="multipart/form-data" class="card card-body">
    <div asp-validation-summary="All" class="field-error" role="alert"></div>
    <input type="hidden" asp-for="Resource.Id" />
    <div class="field"><label asp-for="Resource.Title">Title</label><input asp-for="Resource.Title" class="control" /></div>
    <div class="field"><label asp-for="Resource.LessonId">Lesson</label><select asp-for="Resource.LessonId" class="control"><option value="">Select lesson</option>
    @foreach(var lesson in Model.Lessons) { <option value="@lesson.Id">@lesson.Title</option> }</select></div>
    <div class="field"><label asp-for="Resource.Type">Type</label><select asp-for="Resource.Type" class="control"><option value="Pdf">PDF</option><option>Video</option><option>Audio</option></select></div>
    <div class="field"><label asp-for="Resource.Description">Description</label><textarea asp-for="Resource.Description" class="control" rows="3"></textarea></div>
    <div class="field"><label asp-for="UploadedFile">File</label><input asp-for="UploadedFile" type="file" accept=".pdf,.mp4,.mp3,.wav" class="control" /><p class="muted">PDF/audio: up to 10 MB. MP4 video: up to 50 MB. Leave blank when editing to keep the existing file.</p></div>
    <div class="field"><label asp-for="Resource.Transcript">Transcript / equivalent text</label><textarea asp-for="Resource.Transcript" class="control" rows="6"></textarea></div>
    <div class="field"><label asp-for="CaptionsFile">Video captions (.vtt)</label><input asp-for="CaptionsFile" type="file" accept=".vtt" class="control" /><p class="muted">Required for new videos. Leave blank when editing to retain existing captions.</p></div>
    <div class="actions"><button type="submit" class="btn primary">Save resource</button><a asp-page="Index" class="btn secondary">Cancel</a></div>
</form>

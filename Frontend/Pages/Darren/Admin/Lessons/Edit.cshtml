@page "{id:long?}"
@model SkillBridge.Backend.Pages.Darren.Admin.Lessons.EditModel
@{
    ViewData["Title"] = Model.IsCreate ? "Create Lesson" : "Edit Lesson";
}

<div class="container py-4">
    <h2>@(Model.IsCreate ? "Create lesson" : "Edit lesson")</h2>
    <p class="muted">Add or update course lesson details and text content.</p>

    <form method="post" class="card card-body shadow-sm">
        <div asp-validation-summary="All" class="field-error field"></div>

        <div class="field">
            <label asp-for="Input.CourseId" class="form-label fw-bold">Course *</label>
            <select asp-for="Input.CourseId" class="control">
                <option value="">Select a course...</option>
                @foreach (var c in Model.Courses)
                {
                    <option value="@c.Id">@c.Title</option>
                }
            </select>
            <span asp-validation-for="Input.CourseId" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Title" class="form-label fw-bold">Lesson Title *</label>
            <input asp-for="Input.Title" class="control" placeholder="e.g. Meet Git and your first repository" />
            <span asp-validation-for="Input.Title" class="field-error"></span>
        </div>

        <div class="grid two">
            <div class="field">
                <label asp-for="Input.OrderIndex" class="form-label fw-bold">Order Index *</label>
                <input asp-for="Input.OrderIndex" type="number" class="control" />
                <span asp-validation-for="Input.OrderIndex" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.DurationMinutes" class="form-label fw-bold">Duration (Minutes) *</label>
                <input asp-for="Input.DurationMinutes" type="number" class="control" />
                <span asp-validation-for="Input.DurationMinutes" class="field-error"></span>
            </div>
        </div>

        <div class="field">
            <label asp-for="Input.Content" class="form-label fw-bold">Lesson Text / Instructions *</label>
            <textarea asp-for="Input.Content" class="control" rows="8" placeholder="Write full lesson instructions, command examples, or background notes here..."></textarea>
            <span asp-validation-for="Input.Content" class="field-error"></span>
        </div>

        <div class="actions gap-2">
            <button type="submit" class="btn primary">@(Model.IsCreate ? "Create lesson" : "Save changes")</button>
            <a asp-page="Index" class="btn secondary">Cancel</a>
        </div>
    </form>
</div>

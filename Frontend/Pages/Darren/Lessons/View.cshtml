@page
@model SkillBridge.Web.Pages.Lessons.ViewModel
@{
    ViewData["Title"] = Model.Detail.Lesson.Title;
}
<a asp-page="/ChangZhe/Courses/Detail" asp-route-id="@Model.Detail.Lesson.CourseId" class="breadcrumbs">← @Model.Detail.Lesson.CourseTitle</a>
<div class="page-head">
    <div>
        <p class="eyebrow">LESSON @Model.Detail.Lesson.SequenceNumber · @Model.Detail.Lesson.DurationMinutes MINUTES</p>
        <h1>@Model.Detail.Lesson.Title</h1>
        <p>@Model.Detail.Summary</p>
    </div>
</div>
@if (!Model.Detail.Lesson.IsPublished)
{
    <div class="alert warning" role="status">Administrator preview. This lesson belongs to an unpublished course.</div>
}
<article class="card">
    <div class="card-body">
        <h2>Lesson content</h2>
        @foreach (var paragraph in Model.Detail.Body.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            <p class="body-copy">@paragraph</p>
        }
    </div>
</article>
<section class="card section-space" aria-labelledby="resources-heading">
    <div class="card-body">
        <h2 id="resources-heading">Lesson resources</h2>
        @if (Model.Detail.Resources.Count == 0)
        {
            <p class="muted">No resources have been added to this lesson.</p>
        }
        @foreach (var resource in Model.Detail.Resources)
        {
            <div class="section-space">
                <h3>@resource.Title</h3>
                <p class="muted">@resource.ResourceType · @((resource.SizeBytes / 1024d).ToString("N0")) KiB</p>
                <p>@resource.Description</p>
                @if (resource.ResourceType == "Video")
                {
                    <video controls preload="metadata" class="lesson-media">
                        <source src="@Url.Page("/Darren/Resources/File", new { id = resource.Id })" type="video/mp4" />
                        @if (resource.HasCaptions) { <track kind="captions" srclang="en" label="English" src="@Url.Page("/Darren/Resources/File", new { id = resource.Id, captions = true })" default /> }
                        Your browser does not support this video. Download it below.
                    </video>
                }
                @if (resource.ResourceType == "Audio")
                { <audio controls preload="metadata" class="lesson-media" src="@Url.Page("/Darren/Resources/File", new { id = resource.Id })">Download the audio below.</audio> }
                <a asp-page="/Darren/Resources/File" asp-route-id="@resource.Id" asp-route-download="true" class="btn secondary">Download @resource.ResourceType</a>
                <details class="section-space"><summary>Transcript / equivalent text</summary><p class="resource-transcript">@resource.Transcript</p></details>
            </div>
        }
    </div>
</section>

@if (!User.IsInRole("Admin"))
{
    <form method="post" asp-page-handler="ToggleCompletion" asp-route-id="@Model.Detail.Lesson.Id">
        <button class="btn primary" type="submit">@(Model.IsCompleted ? "Mark incomplete" : "Mark complete")</button>
    </form>
}

@page
@model SkillBridge.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}
<nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-page="/JianYi/Index">Home</a><partial name="_Icon" model='@("chevron")' /><a asp-page="/JianYi/Account/Profile">My profile</a><partial name="_Icon" model='@("chevron")' /><span aria-current="page">Change password</span></nav>
<div class="page-head"><div><h1>Change password</h1><p>Confirm your current password before choosing a new one.</p></div></div>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert success" role="status"><partial name="_Icon" model='@("check")' /><span>@Model.StatusMessage</span></div>
}
<div class="split">
    <section class="card">
        <div class="card-head"><h2>Account security</h2></div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="All" class="validation-summary" role="alert" tabindex="-1"></div>
                <div class="field">
    <label asp-for="Input.CurrentPassword">Current password<span class="required" aria-hidden="true">*</span></label>
    <div class="password-wrap"><input asp-for="Input.CurrentPassword" class="control" type="password" autocomplete="current-password" required maxlength="128" value="" aria-describedby="Input_CurrentPassword_error" /><button class="password-toggle" type="button" data-show-password="Input_CurrentPassword" aria-label="Show current password" aria-pressed="false">Show</button></div>

    <span asp-validation-for="Input.CurrentPassword" class="field-error" id="Input_CurrentPassword_error"></span>
</div>
                <div class="field">
    <label asp-for="Input.NewPassword">New password<span class="required" aria-hidden="true">*</span></label>
    <div class="password-wrap"><input asp-for="Input.NewPassword" class="control" type="password" autocomplete="new-password" required minlength="12" maxlength="128" value="" aria-describedby="Input_NewPassword_error Input_NewPassword_hint" /><button class="password-toggle" type="button" data-show-password="Input_NewPassword" aria-label="Show new password" aria-pressed="false">Show</button></div>
    <div class="hint" id="Input_NewPassword_hint">Use at least 12 characters.</div>
    <span asp-validation-for="Input.NewPassword" class="field-error" id="Input_NewPassword_error"></span>
</div>
                <div class="field">
    <label asp-for="Input.ConfirmPassword">Confirm new password<span class="required" aria-hidden="true">*</span></label>
    <div class="password-wrap"><input asp-for="Input.ConfirmPassword" class="control" type="password" autocomplete="new-password" required minlength="12" maxlength="128" value="" aria-describedby="Input_ConfirmPassword_error Input_ConfirmPassword_hint" /><button class="password-toggle" type="button" data-show-password="Input_ConfirmPassword" aria-label="Show confirm new password" aria-pressed="false">Show</button></div>
    <div class="hint" id="Input_ConfirmPassword_hint">Enter the new password again.</div>
    <span asp-validation-for="Input.ConfirmPassword" class="field-error" id="Input_ConfirmPassword_error"></span>
</div>
                <div class="actions"><button class="btn primary" type="submit">Change password</button><a class="btn secondary" asp-page="/JianYi/Account/Profile">Cancel</a></div>
            </form>
        </div>
    </section>
    <partial name="_AccountHelp" />
</div>
